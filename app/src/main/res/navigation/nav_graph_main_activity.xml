<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph_main_activity"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/addFragment"
        android:name="com.example.kotlinflow.ui.add.AddFragment"
        android:label="ADD USER"
        tools:layout="@layout/fragment_add" />
    <dialog
        android:id="@+id/deleteDialogFragment"
        android:name="com.example.kotlinflow.ui.delete.DeleteDialogFragment"
        android:label="fragment_delete_dialog"
        tools:layout="@layout/fragment_delete_dialog" />
    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.kotlinflow.ui.home.HomeFragment"
        android:label="HOME"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_homeFragment_to_addFragment"
            app:destination="@id/addFragment" />
        <action
            android:id="@+id/action_homeFragment_to_updateFragment"
            app:destination="@id/updateFragment" />
        <action
            android:id="@+id/action_homeFragment_to_deleteDialogFragment"
            app:destination="@id/deleteDialogFragment" />
    </fragment>
    <fragment
        android:id="@+id/updateFragment"
        android:name="com.example.kotlinflow.ui.update.UpdateFragment"
        android:label="UPDATE USER"
        tools:layout="@layout/fragment_update" />
</navigation>